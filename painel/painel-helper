#!/usr/bin/env python3
"""
painel-helper — operações privilegiadas do painel web (VM-Hospedagem).

Executado pelo backend via sudo (usuário "painel"). Senhas chegam sempre pela
entrada padrão, nunca como argumento. Só opera em contas de ALUNO (shell
/bin/shell_ftp e HOME /projetos/<turma>/<login>): contas de docentes e do
sistema nunca são tocadas.

Operações com arquivos são feitas depois de o processo "virar" o aluno
(setuid), com umask 027: os arquivos ficam iguais aos enviados via FTP
(dono = aluno, grupo www-data herdado do setgid da pasta, 640/750).

Remoção dentro de uploads/: o que o PHP do site gravou pertence ao
www-data, e o aluno não consegue apagar o conteúdo de subpastas criadas
pelo PHP. Nesse caso a remoção é repetida como www-data. Nenhuma remoção
é feita como root, e o www-data só alcança o que o PHP do site já alcança.

Uso:
  painel-helper auth <login>             stdin: senha
  painel-helper senha <login>            stdin: senha_atual\nsenha_nova
  painel-helper senha-docente <login>    stdin: senha_atual\nsenha_nova (senha do painel, em docentes.htpasswd)
  painel-helper redefinir <login>        stdin: senha_nova (conta Linux e usuário do MariaDB)
  painel-helper ls <login> [caminho]
  painel-helper put <login> <caminho>    stdin: conteúdo do arquivo
  painel-helper mkdir <login> <caminho>
  painel-helper rm <login> <caminho>
  painel-helper esvaziar <login>         apaga o conteúdo de uploads/ (a pasta fica)

Saída: JSON no stdout (sucesso) ou {"erro": "..."} no stderr com código 1.
"""
import ctypes
import ctypes.util
import errno
import hmac
import json
import os
import pwd
import re
import shutil
import stat
import subprocess
import sys

SHELL_FTP = "/bin/shell_ftp"
DOCENTES = "/etc/painel/docentes.htpasswd"
RE_LOGIN = re.compile(r"^[a-z][a-z0-9]{0,31}$")
MAX_ARQUIVO = 25 * 1024 * 1024
MARIADB = shutil.which("mariadb") or "/usr/bin/mariadb"
HTPASSWD = shutil.which("htpasswd") or "/usr/bin/htpasswd"


class Erro(Exception):
    pass


def sair_ok(dados=None):
    print(json.dumps(dados or {}, ensure_ascii=False))
    sys.exit(0)


def sair_erro(msg, codigo=1):
    print(json.dumps({"erro": msg}, ensure_ascii=False), file=sys.stderr)
    sys.exit(codigo)


# ---------------------------------------------------------------- senhas
_libcrypt = ctypes.CDLL(ctypes.util.find_library("crypt") or "libcrypt.so.1")
_libcrypt.crypt.restype = ctypes.c_char_p
_libcrypt.crypt.argtypes = [ctypes.c_char_p, ctypes.c_char_p]


def confere_hash(senha, hash_):
    if not hash_ or hash_[0] in "!*":  # conta bloqueada ou sem senha
        return False
    r = _libcrypt.crypt(senha.encode(), hash_.encode())
    return r is not None and hmac.compare_digest(r, hash_.encode())


def hash_shadow(login):
    with open("/etc/shadow", encoding="utf-8") as f:
        for linha in f:
            campos = linha.rstrip("\n").split(":")
            if campos[0] == login:
                return campos[1]
    return None


def hash_docente(login):
    try:
        with open(DOCENTES, encoding="utf-8") as f:
            for linha in f:
                nome, _, h = linha.strip().partition(":")
                if nome == login:
                    return h
    except FileNotFoundError:
        pass
    return None


def ler_stdin_linhas(n):
    linhas = sys.stdin.read(4096).split("\n")
    if len(linhas) < n:
        raise Erro("Entrada incompleta.")
    return linhas[:n]


def validar_nova(login, nova):
    if not 8 <= len(nova) <= 128:
        raise Erro("A nova senha precisa ter entre 8 e 128 caracteres.")
    if any(ord(c) < 32 or ord(c) == 127 for c in nova):
        raise Erro("A nova senha tem caracteres inválidos.")
    if login in nova.lower():
        raise Erro("A nova senha não pode conter o seu login.")


def definir_senha(login, nova):
    r = subprocess.run(["chpasswd"], input=f"{login}:{nova}\n", text=True, capture_output=True)
    if r.returncode != 0:
        raise Erro("O sistema recusou a nova senha.")


def definir_senha_docente(login, nova):
    """Grava a nova senha (bcrypt) do docente em docentes.htpasswd.

    Usa o próprio htpasswd, o mesmo do guia de instalação. A senha vai pela
    entrada padrão (-i), nunca como argumento. O htpasswd só troca a linha do
    docente e mantém as dos outros.
    """
    r = subprocess.run([HTPASSWD, "-i", "-B", "-C", "10", DOCENTES, login],
                       input=nova + "\n", text=True, capture_output=True)
    if r.returncode != 0:
        raise Erro("Não foi possível gravar a nova senha. Avise o administrador.")
    os.chmod(DOCENTES, 0o600)


def redefinir_banco(login, nova):
    """Muda a senha do usuário do MariaDB do aluno (mesmo nome do login).

    O helper roda como root, então o mariadb entra pelo unix_socket, sem senha.
    O login já passou por RE_LOGIN (só letras minúsculas e números), então pode
    ir direto no SQL. A senha vai pela entrada padrão, nunca como argumento.

    Retorna: "redefinido", "sem_mariadb", "sem_banco" (o aluno não tem usuário
    no banco) ou "indisponivel" (o MariaDB não respondeu).
    """
    if not os.access(MARIADB, os.X_OK):
        return "sem_mariadb"
    try:
        r = subprocess.run(
            [MARIADB, "--batch", "--skip-column-names", "--execute",
             f"SELECT COUNT(*) FROM mysql.user WHERE User='{login}' AND Host='localhost'"],
            capture_output=True, text=True, timeout=30)
        if r.returncode != 0:
            return "indisponivel"
        if r.stdout.strip() != "1":
            return "sem_banco"
        senha_sql = nova.replace("\\", "\\\\").replace("'", "\\'")
        r = subprocess.run([MARIADB], input=f"ALTER USER '{login}'@'localhost' IDENTIFIED BY '{senha_sql}';\n",
                           capture_output=True, text=True, timeout=30)
    except (OSError, subprocess.TimeoutExpired):
        return "indisponivel"
    return "redefinido" if r.returncode == 0 else "indisponivel"


# ---------------------------------------------------------------- contas
def conta_aluno(login):
    if not RE_LOGIN.match(login or ""):
        raise Erro("Login inválido.")
    try:
        pw = pwd.getpwnam(login)
    except KeyError:
        raise Erro("Conta não encontrada.")
    m = re.match(r"^/projetos/([A-Za-z0-9]+)/" + re.escape(login) + r"/?$", pw.pw_dir)
    if pw.pw_shell != SHELL_FTP or not m or pw.pw_uid < 1000:
        raise Erro("Esta não é uma conta de aluno.")
    return pw, m.group(1)


def virar_aluno(pw):
    os.setgroups([])
    os.setgid(pw.pw_gid)
    os.setuid(pw.pw_uid)
    os.umask(0o027)


# ---------------------------------------------------------------- caminhos
def partes_caminho(rel, criando=False):
    rel = (rel or "").strip("/")
    if not rel:
        return []
    partes = rel.split("/")
    if len(partes) > 20 or len(rel) > 1024:
        raise Erro("Caminho longo demais.")
    for p in partes:
        if p in ("", ".", "..") or len(p.encode()) > 255 or "\\" in p or any(ord(c) < 32 or ord(c) == 127 for c in p):
            raise Erro(f"Nome inválido: {p!r}")
        if criando and p.startswith("."):
            raise Erro(f"Nomes começando com ponto não são publicados: {p}")
    return partes


def abrir_pasta(home, partes, criar=False):
    fd = os.open(home, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
    try:
        for p in partes:
            if criar:
                try:
                    os.mkdir(p, 0o777, dir_fd=fd)
                except FileExistsError:
                    pass
            novo = os.open(p, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=fd)
            os.close(fd)
            fd = novo
        return fd
    except BaseException:
        os.close(fd)
        raise


def cmd_ls(pw, rel):
    fd = abrir_pasta(pw.pw_dir, partes_caminho(rel))
    itens = []
    try:
        with os.scandir(fd) as it:
            for e in it:
                st = e.stat(follow_symlinks=False)
                tipo = "pasta" if stat.S_ISDIR(st.st_mode) else "arquivo" if stat.S_ISREG(st.st_mode) else "outro"
                itens.append({"nome": e.name, "tipo": tipo, "tamanho": st.st_size, "modificado": int(st.st_mtime)})
    finally:
        os.close(fd)
    itens.sort(key=lambda i: (i["tipo"] != "pasta", i["nome"].lower()))
    sair_ok({"itens": itens})


def cmd_put(pw, rel):
    partes = partes_caminho(rel, criando=True)
    if not partes:
        raise Erro("Informe o nome do arquivo.")
    fd = abrir_pasta(pw.pw_dir, partes[:-1], criar=True)
    nome = partes[-1]
    tmp = f".painel-tmp-{os.getpid()}"
    total = 0
    try:
        out = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o666, dir_fd=fd)
        try:
            while True:
                bloco = sys.stdin.buffer.read(1024 * 1024)
                if not bloco:
                    break
                total += len(bloco)
                if total > MAX_ARQUIVO:
                    raise Erro("Arquivo grande demais.")
                os.write(out, bloco)
        finally:
            os.close(out)
        try:
            if stat.S_ISDIR(os.stat(nome, dir_fd=fd, follow_symlinks=False).st_mode):
                raise Erro(f"Já existe uma pasta chamada {nome}.")
        except FileNotFoundError:
            pass
        os.rename(tmp, nome, src_dir_fd=fd, dst_dir_fd=fd)
    except BaseException:
        try:
            os.unlink(tmp, dir_fd=fd)
        except FileNotFoundError:
            pass
        raise
    finally:
        os.close(fd)
    sair_ok({"tamanho": total})


def cmd_mkdir(pw, rel):
    partes = partes_caminho(rel, criando=True)
    if not partes:
        raise Erro("Informe o nome da pasta.")
    fd = abrir_pasta(pw.pw_dir, partes[:-1])
    try:
        os.mkdir(partes[-1], 0o777, dir_fd=fd)
    except FileExistsError:
        raise Erro("Já existe um item com esse nome.")
    finally:
        os.close(fd)
    sair_ok()


def remover(home, partes):
    """Remove um arquivo ou pasta (recursivo), sem seguir links simbólicos."""
    fd = abrir_pasta(home, partes[:-1])
    try:
        st = os.stat(partes[-1], dir_fd=fd, follow_symlinks=False)
        if stat.S_ISDIR(st.st_mode):
            shutil.rmtree(partes[-1], dir_fd=fd)
        else:
            os.unlink(partes[-1], dir_fd=fd)
    finally:
        os.close(fd)


def executar_como(uid, gid, funcao, *args):
    """
    Executa a função num processo filho com o uid/gid indicados.
    Devolve 0 (ok), 2 (não encontrado), 13 (sem permissão) ou 1 (outro erro).
    """
    pid = os.fork()
    if pid == 0:
        codigo = 1
        try:
            os.setgroups([])
            os.setgid(gid)
            os.setuid(uid)
            os.umask(0o027)
            funcao(*args)
            codigo = 0
        except FileNotFoundError:
            codigo = 2
        except PermissionError:
            codigo = 13
        except OSError as e:
            codigo = 13 if e.errno in (errno.EACCES, errno.EPERM, errno.ENOTEMPTY) else 1
        except BaseException:
            codigo = 1
        os._exit(codigo)
    _, status = os.waitpid(pid, 0)
    return os.waitstatus_to_exitcode(status)


def remover_com_fallback(pw, partes):
    """Tenta como o aluno; dentro de uploads/, tenta de novo como www-data."""
    r = executar_como(pw.pw_uid, pw.pw_gid, remover, pw.pw_dir, partes)
    if r == 13 and partes[0] == "uploads" and len(partes) > 1:
        www = pwd.getpwnam("www-data")
        r = executar_como(www.pw_uid, www.pw_gid, remover, pw.pw_dir, partes)
    return r


MENSAGENS_RM = {
    2: "Arquivo ou pasta não encontrado.",
    13: "Sem permissão para apagar esse item.",
    1: "Não foi possível apagar esse item.",
}


def cmd_rm(pw, rel):
    partes = partes_caminho(rel)
    if not partes:
        raise Erro("A pasta principal do site não pode ser apagada.")
    if partes == ["uploads"]:
        raise Erro("A pasta uploads não pode ser apagada. Para limpar o conteúdo, use Esvaziar pasta.")
    r = remover_com_fallback(pw, partes)
    if r != 0:
        raise Erro(MENSAGENS_RM.get(r, MENSAGENS_RM[1]))
    sair_ok()


def cmd_esvaziar(pw):
    # Só lê os nomes (sem seguir links); cada remoção roda sem privilégio.
    fd = abrir_pasta(pw.pw_dir, ["uploads"])
    try:
        nomes = os.listdir(fd)
    finally:
        os.close(fd)
    removidos, falhas = 0, []
    for nome in nomes:
        if remover_com_fallback(pw, ["uploads", nome]) == 0:
            removidos += 1
        else:
            falhas.append(nome)
    sair_ok({"removidos": removidos, "falhas": falhas})


# ---------------------------------------------------------------- main
def main():
    if os.geteuid() != 0:
        sair_erro("Execute via sudo.", 2)
    if len(sys.argv) < 3:
        sair_erro("Uso inválido.", 2)
    cmd, login = sys.argv[1], sys.argv[2]
    rel = sys.argv[3] if len(sys.argv) > 3 else ""

    if cmd == "auth":
        if not RE_LOGIN.match(login):
            raise Erro("Login ou senha incorretos.")
        senha = ler_stdin_linhas(1)[0]
        h = hash_docente(login)
        if h is not None:
            if confere_hash(senha, h):
                sair_ok({"papel": "docente"})
            raise Erro("Login ou senha incorretos.")
        try:
            _, turma = conta_aluno(login)
        except Erro:
            raise Erro("Login ou senha incorretos.")
        if confere_hash(senha, hash_shadow(login)):
            sair_ok({"papel": "aluno", "turma": turma})
        raise Erro("Login ou senha incorretos.")

    if cmd == "senha-docente":
        atual, nova = ler_stdin_linhas(2)
        h = hash_docente(login) if RE_LOGIN.match(login) else None
        if h is None:
            raise Erro("Docente não encontrado.")
        if not confere_hash(atual, h):
            raise Erro("A senha atual está incorreta.")
        if atual == nova:
            raise Erro("A nova senha precisa ser diferente da atual.")
        validar_nova(login, nova)
        definir_senha_docente(login, nova)
        sair_ok()

    pw, _ = conta_aluno(login)

    if cmd == "senha":
        atual, nova = ler_stdin_linhas(2)
        if not confere_hash(atual, hash_shadow(login)):
            raise Erro("A senha atual está incorreta.")
        if atual == nova:
            raise Erro("A nova senha precisa ser diferente da atual.")
        validar_nova(login, nova)
        definir_senha(login, nova)
        sair_ok()
    if cmd == "redefinir":
        nova = ler_stdin_linhas(1)[0]
        validar_nova(login, nova)
        definir_senha(login, nova)
        # A senha do banco é independente da conta Linux; "redefinir" volta as duas
        sair_ok({"banco": redefinir_banco(login, nova)})

    operacoes = {"ls": cmd_ls, "put": cmd_put, "mkdir": cmd_mkdir}
    if cmd not in operacoes and cmd not in ("rm", "esvaziar"):
        sair_erro("Comando desconhecido.", 2)
    try:
        if cmd == "rm":
            cmd_rm(pw, rel)
        elif cmd == "esvaziar":
            cmd_esvaziar(pw)
        virar_aluno(pw)
        operacoes[cmd](pw, rel)
    except FileNotFoundError:
        raise Erro("Arquivo ou pasta não encontrado.")
    except NotADirectoryError:
        raise Erro("Parte do caminho é um arquivo, não uma pasta.")
    except PermissionError:
        raise Erro("Sem permissão para essa operação.")
    except OSError as e:
        if e.errno == errno.ELOOP:
            raise Erro("Links simbólicos não são permitidos.")
        if e.errno == errno.ENOSPC or e.errno == errno.EDQUOT:
            raise Erro("Sem espaço em disco.")
        raise Erro(f"Erro do sistema: {e.strerror}")


if __name__ == "__main__":
    try:
        main()
    except Erro as e:
        sair_erro(str(e))
